# SiteGuard AI — Frontend Environment Configuration
# Copy this file to .env and configure when connecting the Python FastAPI/Flask backend in Phase 3

# Base URL for the Python YOLO inference & incident API backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Toggle live API requests ("true" when backend server is active, "false" to use Phase 2 frontend demo/mock mode)
VITE_ENABLE_LIVE_API=false
